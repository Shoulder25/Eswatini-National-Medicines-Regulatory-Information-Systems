NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enmris
DB_USER=eNMRIS
DB_PASSWORD=

# Generate each key once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=
AUTH_RATE_LIMIT_KEY=

# Temporary prototype test value only. Replace with exact MRA domains before production.
ALLOWED_EMAIL_DOMAINS=ethereal.email
# Optional test-only domains; ignored in production and forbidden when set there.
DEV_TEST_EMAIL_DOMAINS=
DEV_TEST_INBOX=

# Ethereal SMTP sends test messages to the Ethereal Messages page, not real recipients.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@ethereal.email
APP_BASE_URL=http://localhost:5173

# Required only when serving the frontend from a different origin.
APP_ORIGIN=
# Set to the exact number of trusted reverse-proxy hops in production.
TRUST_PROXY_HOPS=0
